@page
@model Cliente_Front_end.Pages.Tesis.CreateModel
@{
    ViewData["Title"] = "Nueva tesis";
}

<div class="page-header">
    <h1 class="page-title">Nueva tesis</h1>
    <p class="page-subtitle">No se permiten títulos duplicados. Cada autor admite máximo 3 tesis.</p>
</div>

<div class="row">
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Tesis.Titulo" class="form-label">Título</label>
                        <input asp-for="Tesis.Titulo" class="form-control"
                               placeholder="Ej. Sistema de gestión de tesis" />
                        <span asp-validation-for="Tesis.Titulo" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tesis.Estudiante" class="form-label">Estudiante</label>
                        <input asp-for="Tesis.Estudiante" class="form-control"
                               placeholder="Ej. Carlos Flores" />
                        <span asp-validation-for="Tesis.Estudiante" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Tesis.Estado" class="form-label">Estado</label>
                        <select asp-for="Tesis.Estado" class="form-select">
                            <option value="">-- Seleccione un estado --</option>
                            <option value="En proceso">En proceso</option>
                            <option value="Aprobada">Aprobada</option>
                            <option value="Pendiente">Pendiente</option>
                            <option value="Revisión">Revisión</option>
                        </select>
                        <span asp-validation-for="Tesis.Estado" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Tesis.Id_Tutor" class="form-label">Autor</label>
                        @if (Model.AutoresDisponibles.Any())
                        {
                            <select asp-for="Tesis.Id_Tutor" class="form-select">
                                <option value="">-- Seleccione un autor --</option>
                                @foreach (var autor in Model.AutoresDisponibles)
                                {
                                    <option value="@autor.Id">@autor.Nombre (@autor.Especialidad)</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div class="alert alert-warning mb-0">
                                Todos los autores ya tienen 3 tesis. Registra un nuevo autor.
                            </div>
                        }
                        <span asp-validation-for="Tesis.Id_Tutor" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-magenta">Guardar tesis</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
