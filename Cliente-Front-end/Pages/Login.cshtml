@page
@model Cliente_Front_end.Pages.LoginModel
@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="row justify-content-center mt-4">
    <div class="col-md-6 col-lg-4">
        <div class="card shadow border-0">
            <div class="card-body p-4">
                <h1 class="page-title h3 text-center mb-1">Iniciar sesión</h1>
                <p class="text-center text-muted mb-4">Accede para gestionar tesis y autores.</p>

                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Usuario" class="form-label">Usuario</label>
                        <input asp-for="Usuario" class="form-control" autocomplete="username"
                               placeholder="admin" autofocus />
                    </div>

                    <div class="mb-4">
                        <label asp-for="Password" class="form-label">Contraseña</label>
                        <input asp-for="Password" type="password" class="form-control"
                               autocomplete="current-password" placeholder="••••••••" />
                    </div>

                    <button type="submit" class="btn btn-magenta w-100">Entrar</button>
                </form>

                <div class="alert alert-light border mt-4 mb-0 small text-center">
                    Usuario de prueba: <strong>admin</strong> / <strong>Admin123*</strong>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
